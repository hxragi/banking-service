POSTGRES_USER=bank
POSTGRES_PASSWORD=PPASSWORD
POSTGRES_DB=bank

DATABASE__URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:15432/${POSTGRES_DB}
DATABASE__MAX_CONNECTIONS=10
DATABASE__CONNECTION_TIMEOUT_SECS=30
DATABASE__DEFAULT_STATEMENT_TIMEOUT_SECS=30

DRAGONFLY__URL=redis://localhost:6379

CACHE__BALANCE_CACHE_TTL_SECS=60

SERVER__GRPC_HOST=0.0.0.0
SERVER__GRPC_PORT=50051
SERVER__HTTP_HOST=0.0.0.0
SERVER__HTTP_PORT=8080

KAFKA__BOOTSTRAP_SERVERS=localhost:9092
KAFKA__PRODUCER_TIMEOUT_MS=5000
KAFKA__COMPRESSION_TYPE=snappy
KAFKA__MAX_RETRIES=3
KAFKA__RETRY_BACKOFF_MS=100

TRANSACTION_RETRY__MAX_ATTEMPTS=5
TRANSACTION_RETRY__BASE_DELAY_MS=50
TRANSACTION_RETRY__MAX_DELAY_MS=2000

SENTRY__ENVIRONMENT=production
SENTRY__SAMPLE_RATE=0.1

TELEMETRY__OTEL_ENDPOINT=http://jaeger:4318/v1/traces
TELEMETRY__OTEL_TIMEOUT_SECS=3

INTERNAL_API_KEY=RANDOM_E

RUST_LOG=info

JWT_SECRET=EEE
